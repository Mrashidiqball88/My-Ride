[Unit]
Description=My Ride local Redis acceleration layer
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/myride.conf --supervised systemd
ExecStop=/usr/bin/redis-cli -h 127.0.0.1 -p 6379 shutdown
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
# Firebase Authentication Phone OTP / password recovery
# Set these as environment variables in each deployment. Do not commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web app configuration. These values are public by design and are
# returned to the browser only after the entered number is a My Ride account.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
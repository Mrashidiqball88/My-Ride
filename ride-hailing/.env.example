# ─────────────────────────────────────────────────────────────────────────────
# My Ride production process contract
# ─────────────────────────────────────────────────────────────────────────────
# The production start command is:
#   NODE_ENV=production pnpm start
#
# The server reads these values normally from the app-local .env file or the
# repository-root .env file. Process environment variables take precedence.
# Keep demo/test flags disabled for production deployments.
NODE_ENV=production
DEMO_ACCOUNTS_ENABLED=false
PHONE_OTP_TEST_MODE=false
MYRIDE_TEST_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# Required production infrastructure
# ─────────────────────────────────────────────────────────────────────────────
# MONGO_URI is canonical. The server also accepts MONGODB_URI, MONGO_URL, or
# MONGODB_URL for DigitalOcean/systemd environments that use an older name.
# DATABASE_URL is accepted only when its value starts with mongodb:// or
# mongodb+srv://; PostgreSQL DATABASE_URL values are never sent to Mongoose.
MONGO_URI=
REDIS_URL=redis://:

# JWT/session and at-rest encryption keys. Use independently generated values.
JWT_SECRET=
SESSION_SECRET=
PAYMENT_CONFIG_ENCRYPTION_KEY=

# Super Admin credentials.
# Keep passwords and recovery keys in Replit Secrets; only bcrypt hashes are
# stored in MongoDB.
# Existing Customer/Driver and legacy Settings records are never Admin sources.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RECOVERY_KEY=

# MongoDB connection tuning. Atlas deployments retry indefinitely by default
# after a failed initial connection; set MONGO_INITIAL_RETRY_ATTEMPTS to a
# positive number to impose a finite startup retry budget.
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_HEARTBEAT_FREQUENCY_MS=10000
MONGO_INITIAL_RETRY_ATTEMPTS=0
MONGO_INITIAL_RETRY_DELAY_MS=5000
MONGO_MAX_RETRY_DELAY_MS=30000

# Mapbox public token. Keep it in Replit Secrets for the web and native apps;
# it is intentionally exposed to the browser/native map SDK at runtime.
MAPBOX_PUBLIC_TOKEN=

# Persistent Web Push credentials. Ephemeral generated keys are not allowed in
# production because they invalidate browser subscriptions after a restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# SMTP settings for Admin security OTPs and customer/driver password recovery.
# Admin password and recovery-key changes require SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional same-origin/CORS allowlist. Native clients do not send an Origin
# header; browser origins should be comma-separated when cross-origin access
# is deliberately required.
CORS_ORIGIN=
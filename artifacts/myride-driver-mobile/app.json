{
  "expo": {
    "name": "My Ride Driver",
    "slug": "myride-driver-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/myride-driver-icon.png",
    "scheme": "myride-driver-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
        "image": "./assets/images/myride-driver-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myride.driver",
      "infoPlist": {
        "NSCameraUsageDescription": "My Ride uses the camera when you choose to capture driver documents.",
        "NSLocationWhenInUseUsageDescription": "My Ride uses your location to match you with nearby rides while you are online.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "My Ride keeps your location updated while you are online so riders can receive reliable driver tracking."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "SYSTEM_ALERT_WINDOW",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "USE_FULL_SCREEN_INTENT"
      ],
      "package": "com.myride.driver"
    },
    "web": {
      "favicon": "./assets/images/myride-driver-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "My Ride keeps your location updated while you are online so riders can receive reliable driver tracking."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#38BDF8"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
